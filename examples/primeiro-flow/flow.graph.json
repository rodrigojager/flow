      "gateDecisions": [
        {
          "id": "aprovar",
          "label": "Aprovar",
          "decision": "continue",
          "toNodeId": "executar-paralelo"
        },
        {
          "id": "aguardar",
          "label": "Aguardar",
          "decision": "wait"
        },
        {
          "id": "rejeitar",
          "label": "Rejeitar",
          "decision": "fail"
        }
      ],
      "position": {
        "x": 540,
        "y": 300
      }
    },
    {
      "id": "executar-paralelo",
      "type": "fork",
      "label": "Executar em paralelo",
      "fork": {
        "branches": [
          "executor",
          "pesquisador"
        ],
        "join": "consolidar",
        "maxConcurrency": 2
      },
      "position": {
        "x": 790,
        "y": 100
      }
    },
    {
      "id": "executor",
      "type": "agent",
      "label": "Executar",
      "prompt": "Execute o plano {{flow.plan}} e devolva resultado e evidências.",
