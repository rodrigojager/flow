      "next": "rotear-risco",
      "position": {
        "x": 290,
        "y": 100
      }
    },
    {
      "id": "rotear-risco",
      "type": "router",
      "label": "Risco aceitável?",
      "condition": "Boolean(context.flow?.plan) && context.flow?.risk !== \"high\"",
      "position": {
        "x": 540,
        "y": 100
      }
    },
    {
      "id": "gate-risco",
      "type": "gate",
      "label": "Aprovar risco",
      "gate": {
        "kind": "human",
        "prompt": "O plano de risco alto pode prosseguir?",
