{
  "name": "@cybervinci/flow-shared",
  "version": "1.74.0",
  "description": "Shared typed model and execution engine for Graph Studio flows",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -b tsconfig.json --force",
    "compile": "npm run build",
    "test": "npm run build && node --test test/flow-studio-engine.test.js",
    "watch": "npx tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "ajv": "8.20.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
