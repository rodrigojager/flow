{
  "name": "@cybervinci/flow",
  "version": "1.74.0",
  "description": "Flow CLI and local visual server for CyberVinci graphs",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "bin": {
    "flow": "lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -b tsconfig.json --force",
    "catalog:update": "node scripts/update-provider-catalog.mjs",
    "compile": "npm run build",
    "test": "npm run build && node --check src/web/studio.js && node --test --test-concurrency=1 test/*.test.js",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@cybervinci/flow-shared": "1.74.0",
    "chalk": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "11.11.4",
    "tslib": "^2.8.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "README.md"
  ]
}
